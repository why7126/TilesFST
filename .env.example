# ==============================================================================
# Tile Info Platform - Environment Variables Example
# ==============================================================================
# 复制本文件为 .env 后按需修改；禁止提交真实 .env、密钥、生产地址。
# 维护要求：新增或修改任一变量时，必须在变量上一行同步补充用途、取值范围或安全边界注释。

# 生产镜像统一版本 tag；backend/web 默认共用此值，发版时只需改这一处。
TILESFST_IMAGE_TAG=v0.0.4
# 后端生产镜像仓库名；Compose 会拼接为 ${TILESFST_BACKEND_IMAGE_REPOSITORY}:${TILESFST_IMAGE_TAG}。
TILESFST_BACKEND_IMAGE_REPOSITORY=tilesfst-backend
# Web 生产镜像仓库名；Compose 会拼接为 ${TILESFST_WEB_IMAGE_REPOSITORY}:${TILESFST_IMAGE_TAG}。
TILESFST_WEB_IMAGE_REPOSITORY=tilesfst-web

# 后端 Docker 构建基础镜像；网络受限时可改为 m.daocloud.io/docker.io/python:3.12-slim。
BACKEND_PYTHON_BASE_IMAGE=python:3.12-slim
# Web Docker 构建 Node 基础镜像；网络受限时可改为 m.daocloud.io/docker.io/node:22-alpine。
WEB_NODE_BASE_IMAGE=node:22-alpine
# Web Docker 运行 Nginx 基础镜像；网络受限时可改为 m.daocloud.io/docker.io/nginx:1.27-alpine。
WEB_NGINX_BASE_IMAGE=nginx:1.27-alpine

# 应用标识，用于日志与内部命名。
APP_NAME=tilesfst
# 运行环境：development / staging / production；production 必须配置 MySQL DATABASE_URL。
APP_ENV=development
# 是否开启调试模式；生产环境 MUST 设为 false。
APP_DEBUG=true
# JWT 签名与敏感操作密钥；本地使用示例值，生产 MUST 通过密钥管理系统注入。
APP_SECRET_KEY=change-me-in-local-env
# JWT 访问令牌有效期（分钟）；「记住我」未勾选时使用。
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
# JWT 访问令牌有效期（天）；登录勾选「记住我」时使用。
JWT_REMEMBER_ME_EXPIRE_DAYS=7

# 默认管理员用户名；仅首次创建空库 admin 账号时使用。
ADMIN_USERNAME=admin
# 默认管理员初始密码；首次建库或显式恢复开关启用时生效，生产 MUST 修改。
ADMIN_INITIAL_PASSWORD=change-me-on-first-run
# 是否在服务启动时将 admin 密码重置为 ADMIN_INITIAL_PASSWORD；默认 false，仅本地/演示临时启用。
ADMIN_RESET_PASSWORD_ON_STARTUP=false

# Docker 宿主机映射的后端 API 端口；容器内固定 8000，多项目冲突时改此项。
HOST_PORT_BACKEND=8000
# Docker 宿主机映射的 Web 前端端口；容器内 Nginx 固定 80。
HOST_PORT_WEB=3000
# Docker 宿主机映射的 Mintlify 文档站预览端口；仅启用 docs-site profile 时使用，容器内固定 3000。
HOST_PORT_MINTLIFY_DOCS=3001
# Docker 宿主机映射的 WorkBuddy MCP HTTPS 服务端口；本地 stdio PoC 不使用该端口。
HOST_PORT_WORKBUDDY_MCP=8010
# WorkBuddy 隔离验收不使用宿主机端口或本文件；脚本临时注入已有 APP_SECRET_KEY、ADMIN_INITIAL_PASSWORD、OBJECT_STORAGE_SECRET_KEY，并仅在测试容器内将 MAX_IMAGE_SIZE_MB/MAX_VIDEO_SIZE_MB/MAX_FILE_SIZE_MB 设为 1。
# Docs-site Docker 构建 Node 基础镜像；网络受限时可改为 m.daocloud.io/docker.io/node:22-alpine。
DOCS_SITE_NODE_BASE_IMAGE=node:22-alpine
# Docs-site 预览镜像仓库名；Compose 会拼接为 ${TILESFST_DOCS_SITE_IMAGE_REPOSITORY}:${TILESFST_IMAGE_TAG}。
TILESFST_DOCS_SITE_IMAGE_REPOSITORY=tilesfst-docs-site
# Docs-site 镜像内预装的 Mintlify CLI 版本；升级前需通过文档站校验与 preview 验收。
MINTLIFY_CLI_VERSION=4.2.45
# Docker 宿主机映射的 MinIO S3 API 端口；容器内固定 9000。
HOST_PORT_MINIO_API=9000
# Docker 宿主机映射的 MinIO Console 管理界面端口；容器内固定 9001。
HOST_PORT_MINIO_CONSOLE=9001

# 后端 FastAPI 监听地址；Docker 内通常为 0.0.0.0。
BACKEND_HOST=0.0.0.0
# 后端容器内监听端口；与 docker-compose 映射的容器侧端口一致，一般勿改。
BACKEND_PORT=8000
# 允许跨域的前端 Origin 列表，逗号分隔；需包含 Web 访问地址。
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 前端构建或直连后端时使用的 API 基址；Docker Web 经 Nginx 反代时可指向 backend 服务。
VITE_API_BASE_URL=http://localhost:8000
# WorkBuddy 连接器访问后端 API 的基址；stdio PoC 可使用宿主机地址，容器内远程 MCP 可使用 backend 服务地址。
TILESFST_API_BASE_URL=http://localhost:8000
# WorkBuddy 连接器调用后端管理 API 的 Bearer Token；示例文件留空，真实值必须由本地环境或企业密钥系统注入。
TILESFST_CONNECTOR_TOKEN=
# WorkBuddy 连接器调用后端 API 的超时时间（秒）。
TILESFST_CONNECTOR_TIMEOUT_SECONDS=10
# WorkBuddy 管理写工具总开关；默认 false，仅企业鉴权、审计和人工确认链路完成后开启。
TILESFST_CONNECTOR_ENABLE_WRITE_TOOLS=false
# WorkBuddy 写工具授权范围，逗号分隔；为空表示没有写权限。
TILESFST_CONNECTOR_WRITE_SCOPES=
# WorkBuddy MCP 传输形态：stdio / streamable-http；本地 PoC 默认 stdio。
TILESFST_CONNECTOR_TRANSPORT=stdio
# 已废弃：远程入口不再接受共享 Bearer，改用下面的按用户映射文件；保留变量仅用于迁移识别。
TILESFST_CONNECTOR_HTTP_BEARER_TOKEN=
# 远程入口必需：受控 JSON 文件路径，键为连接器凭据 SHA-256，值含 backend_token 和 scopes；真实文件不得提交。
TILESFST_CONNECTOR_REMOTE_CREDENTIALS_FILE=
# 写操作幂等账本目录；持久化挂载且所有实例共享，不能删除 pending/uncertain 记录后自动重试。
TILESFST_CONNECTOR_IDEMPOTENCY_DIR=data/workbuddy/idempotency
# WorkBuddy HTTPS MCP 简易限流，每客户端每分钟请求数。
TILESFST_CONNECTOR_RATE_LIMIT_PER_MINUTE=60
# 远程 MCP JSON 请求体上限，包含 Base64 膨胀；默认 8 MiB，与网关和后端上传限制协调。
TILESFST_CONNECTOR_MAX_REQUEST_BYTES=8388608
# 统一数据库连接 URL；本地/demo 默认 SQLite，production MUST 覆盖为 MySQL 8.0+。
# 生产示例：mysql+pymysql://tiles_user:replace-with-secret@mysql.example.com:3306/tilesfst?charset=utf8mb4
DATABASE_URL=sqlite:////app/data/sqlite/tilesfst.db

# 对象存储提供方：minio / self-hosted-minio / s3-compatible / tencent-cos / volcengine-tos。
OBJECT_STORAGE_PROVIDER=minio
# 对象存储 S3 兼容 endpoint（host:port，不含 http/https）；本地 MinIO 使用 tilesfst-minio:9000。
OBJECT_STORAGE_ENDPOINT=tilesfst-minio:9000
# 对象存储访问密钥；生产 MUST 通过密钥管理注入。
OBJECT_STORAGE_ACCESS_KEY=minioadmin
# 对象存储秘密密钥；示例值仅用于本地，禁止提交真实值。
OBJECT_STORAGE_SECRET_KEY=minioadmin
# 是否使用 HTTPS 连接对象存储；本地 Docker 为 false，COS/TOS 通常为 true。
OBJECT_STORAGE_SECURE=false
# 对象存储 Bucket；云上 COS/TOS 等场景必须由运维提前创建。
OBJECT_STORAGE_BUCKET=tilesfst
# 对象存储区域；COS/TOS 等云上 S3 兼容服务通常必填，本地 MinIO 可留空。
OBJECT_STORAGE_REGION=
# 是否使用 path-style 访问；MinIO 通常为 true，部分云厂商 virtual-host 风格可设为 false。
OBJECT_STORAGE_PATH_STYLE=true
# 是否允许应用自动创建 Bucket；本地/自建 MinIO 可 true，云上对象存储生产 MUST 为 false。
OBJECT_STORAGE_AUTO_CREATE_BUCKET=true
# 是否由后端返回对象存储短期直出读取 URL；默认 false 走 /media 受控代理，生产开启前需确认桶权限与 CDN/签名策略。
OBJECT_STORAGE_DIRECT_READ_ENABLED=false
# REQ-0135：仅控制新视频会话；默认关闭。完成控制/业务绑定/Web/Compose验收后灰度启用。
# 回滚设 false，已有直传会话仍可确认；不要变更原 COS bucket/region/版本控制配置。
OBJECT_STORAGE_DIRECT_VIDEO_UPLOAD_ENABLED=false
# SKU图片、品牌Logo、Banner、头像、证书图片及PDF直传，默认false；图片需先启动受限image-processing工作者，PDF跳过派生。
OBJECT_STORAGE_DIRECT_IMAGE_UPLOAD_ENABLED=false
# 对象存储直出读取 URL 有效期（秒）；后端会限制在 60-3600 秒。
OBJECT_STORAGE_DIRECT_READ_EXPIRES_SECONDS=300

# V5 单桶策略：一个项目一个 Bucket，桶内用前缀区分资源类型。
# 图片类上传对象前缀（头像、Logo、SKU 图等）。
OBJECT_STORAGE_PREFIX_IMAGES=images/
# Deprecated：legacy 图片前缀；新上传 MUST 使用 OBJECT_STORAGE_PREFIX_IMAGES。
OBJECT_STORAGE_PREFIX_ORIGINAL=original/
# 文档类对象前缀（预留）。
OBJECT_STORAGE_PREFIX_FILES=files/
# 音频类对象前缀（预留）。
OBJECT_STORAGE_PREFIX_AUDIOS=audios/
# 缩略图对象前缀。
OBJECT_STORAGE_PREFIX_THUMBNAILS=thumbnails/
# 后端处理产物对象前缀。
OBJECT_STORAGE_PREFIX_PROCESSED=processed/
# 临时上传/中间文件对象前缀。
OBJECT_STORAGE_PREFIX_TEMP=tmp/
# 数据导入文件对象前缀。
OBJECT_STORAGE_PREFIX_IMPORT=imports/
# 数据导出文件对象前缀。
OBJECT_STORAGE_PREFIX_EXPORT=exports/
# 视频原文件对象前缀。
OBJECT_STORAGE_PREFIX_VIDEO=videos/
# 视频封面图对象前缀。
OBJECT_STORAGE_PREFIX_VIDEO_COVER=videos/covers/
# 视频转码输出对象前缀（VIDEO_TRANSCODE_ENABLED 启用时使用）。
OBJECT_STORAGE_PREFIX_VIDEO_TRANSCODED=videos/transcoded/

# 本地开发数据根目录（相对项目根）；Docker 卷映射见 docker-compose.yml。
DATA_ROOT=./data

# 单张图片上传大小上限（MB）；须 ≤ Web Nginx client_max_body_size。
MAX_IMAGE_SIZE_MB=20
# 允许的图片 MIME 类型，逗号分隔。
ALLOWED_IMAGE_TYPES=image/jpeg,image/jpg,image/png,image/webp,image/gif,image/svg+xml,image/bmp,image/tiff,image/heic

# 单个视频上传大小上限（MB）；须 ≤ Web Nginx client_max_body_size。
MAX_VIDEO_SIZE_MB=500
# 单个文档 / 证书文件上传大小上限（MB）；须 ≤ Web Nginx client_max_body_size。
MAX_FILE_SIZE_MB=25
# 允许的视频 MIME 类型，逗号分隔。
ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime,video/x-msvideo,video/webm,video/x-matroska,video/mpeg,video/3gpp

# Web Nginx 上传专用请求体上限；生产应 ≥ max(MAX_IMAGE_SIZE_MB, MAX_VIDEO_SIZE_MB, MAX_FILE_SIZE_MB)，默认 512m。
UPLOAD_CLIENT_MAX_BODY_SIZE=512m
# Web Nginx 读取浏览器上传请求体超时（秒）；视频上传默认 600 秒。
UPLOAD_CLIENT_BODY_TIMEOUT_SECONDS=600
# Web Nginx 连接 backend 的超时（秒）；默认 60 秒。
UPLOAD_PROXY_CONNECT_TIMEOUT_SECONDS=60
# Web Nginx 向 backend 发送上传请求的超时（秒）；视频上传默认 600 秒。
UPLOAD_PROXY_SEND_TIMEOUT_SECONDS=600
# Web Nginx 等待 backend 上传响应的超时（秒）；生产 COS/TOS 大视频默认 600 秒。
UPLOAD_PROXY_READ_TIMEOUT_SECONDS=600
# Web Nginx 向浏览器发送上传响应的超时（秒）；视频上传默认 600 秒。
UPLOAD_SEND_TIMEOUT_SECONDS=600
# 上传路径是否启用 Nginx 请求缓冲；大文件生产默认 off，避免先写 client_temp 再转发导致 60 秒链路超时。
UPLOAD_PROXY_REQUEST_BUFFERING=off

# 后端本地处理产物目录（Docker 卷 ./data/processed）；非 MinIO 业务对象存储路径。
PROCESSED_DIR=/app/data/processed
# 后端临时文件目录（Docker 卷 ./data/tmp）。
TMP_DIR=/app/data/tmp

# 是否启用视频上传与管理能力。
VIDEO_ENABLED=true
# 上传视频后是否自动生成封面图。
VIDEO_GENERATE_COVER=true
# 是否启用视频转码（可选增强，默认关闭）。
VIDEO_TRANSCODE_ENABLED=false

# REQ-0136：允许直读的端；逗号分隔web_admin/web_catalog/wechat_miniapp，空值关闭；仍需总开关开启。
MEDIA_READ_CLIENTS=web_admin,web_catalog,wechat_miniapp
# 允许直读的业务媒体类型；仅控制读取路径，不授予业务权限。
MEDIA_READ_KINDS=sku_image,sku_video,brand_logo,banner_image,certificate,avatar,upload_session,store_logo
# 是否允许客户端显式申请有界代理回退；默认false，不因存储故障自动启用。
MEDIA_READ_PROXY_FALLBACK_ENABLED=false

# 同宿主机所有后端工作进程/副本必须共享此本地目录；不得在线删除文件，损坏时拒绝代理；不支持跨宿主机/NFS。
MEDIA_READ_PROXY_BUDGET_DIR=/app/data/tmp/media-read-budget
