# OS / editor
.DS_Store

# Local environment
.env
.env.local
.env.mysql
.env.prod-backfill
src/backend/.env.*
!src/backend/.env.example
deploy/**/*.env
deploy/**/*.env.local
deploy/**/*.env.prod
scripts/build-images.env
.venv/

# Python
__pycache__/
*.pyc
.pytest_cache/
coverage/

# Node / frontend build
node_modules/
dist/
build/
**/test-results/

# Local databases and object-store runtime files
*.sqlite3
*.db
.minio/

# Runtime data and local data assets
/data/

# WeChat developer local preferences
src/miniapp/project.private.config.json

# Product release docs: keep source, ignore generated Mintlify output
/releases/.mintlify/**
/releases/dist/**
/releases/build/**
/releases/*/images/**
/mintlify/.mintlify/**
/mintlify/dist/**
/mintlify/build/**
/mintlify/.next/**
/mintlify/node_modules/**

# Deploy runtime and large artifacts
/deploy/**/data/**
/deploy/**/*.db
/deploy/**/*.sqlite
/deploy/**/*.sqlite3
/deploy/**/*.tar
/deploy/**/*.tar.gz
