.home-floating-area {
  position: fixed;
  right: 32rpx;
  bottom: calc(36rpx + env(safe-area-inset-bottom));
  z-index: 24;
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 52rpx;
  box-sizing: border-box;
}

.home-floating-area.offset-actionbar {
  bottom: calc(190rpx + env(safe-area-inset-bottom));
}

.home-floating-area.offset-list {
  bottom: calc(124rpx + env(safe-area-inset-bottom));
}

.home-floating-area.offset-tabbar {
  bottom: calc(156rpx + env(safe-area-inset-bottom));
}

.home-floating-area.offset-high {
  bottom: calc(250rpx + env(safe-area-inset-bottom));
}

.home-floating-button {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(200,160,85,0.44);
  border-radius: 48rpx;
  background: rgba(24,22,15,0.92);
  box-shadow: 0 14rpx 34rpx rgba(0,0,0,0.36);
  color: #F1D99B;
  box-sizing: border-box;
}

.home-floating-icon {
  height: 36rpx;
  color: #C8A055;
  font-size: 34rpx;
  line-height: 36rpx;
  font-weight: 800;
}

.home-floating-label {
  margin-top: 2rpx;
  color: #F7F1E6;
  font-size: 20rpx;
  line-height: 24rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.home-floating-press .home-floating-button,
.home-floating-area.is-busy .home-floating-button {
  transform: scale(0.94);
  opacity: 0.82;
}
