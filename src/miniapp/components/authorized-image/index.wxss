:host { display: block; width: 100%; height: 100%; }
.read-frame { position: relative; width: 100%; height: 100%; overflow: hidden; }
.read-image { width: 100%; height: 100%; display: block; }
.read-state { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; font-size: 20rpx; color: var(--color-text-secondary); background: var(--color-surface); }
.read-retry { margin: 0; color: inherit; background: transparent; font-size: 20rpx; }
