.page {
  min-height: 100vh;
  padding-bottom: 32rpx;
  background: #18160F;
  color: #EDE8DF;
  overflow-x: hidden;
}

.content {
  padding-bottom: 24rpx;
}

.media-wrap {
  position: relative;
  min-height: 680rpx;
  background: #211E16;
}

.gallery,
.gallery-image,
.gallery-file {
  width: 100%;
  height: 680rpx;
}

.gallery-image {
  display: block;
  background: #211E16;
}

.gallery-file {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 18rpx;
  background: #211E16;
}

.file-mark {
  min-width: 144rpx;
  min-height: 144rpx;
  border: 2rpx solid rgba(200,160,85,0.42);
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #C8A055;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 144rpx;
}

.file-name {
  max-width: 520rpx;
  color: rgba(237,232,223,0.68);
  font-size: 26rpx;
  line-height: 1.4;
  text-align: center;
  word-break: break-all;
}

.media-count,
.media-error {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 22rpx;
  background: rgba(24,22,15,0.82);
  color: #EDE8DF;
  font-size: 22rpx;
  line-height: 44rpx;
}

.media-error {
  left: 24rpx;
  right: auto;
  max-width: 500rpx;
  color: #C8A055;
}

.summary,
.brand-card-section,
.panel {
  margin: 22rpx 26rpx 0;
}

.summary,
.panel {
  border: 1rpx solid rgba(200,160,85,0.2);
  border-radius: 16rpx;
  background: #211E16;
  box-shadow: 0 12rpx 34rpx rgba(0,0,0,0.18);
}

.summary {
  padding: 28rpx;
}

.type-badge {
  max-width: 100%;
  display: inline-flex;
  min-height: 42rpx;
  padding: 0 16rpx;
  align-items: center;
  border-radius: 21rpx;
  background: rgba(200,160,85,0.16);
  color: #C8A055;
  font-size: 22rpx;
  line-height: 42rpx;
  box-sizing: border-box;
}

.certificate-name {
  margin-top: 18rpx;
  color: #F7F1E6;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.24;
  word-break: break-all;
}

.panel {
  padding: 26rpx;
}

.panel-title {
  margin-bottom: 18rpx;
  color: #F7F1E6;
  font-size: 30rpx;
  font-weight: 700;
}

.field {
  min-height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  border-bottom: 1rpx solid rgba(237,232,223,0.08);
  color: #AFA58E;
  font-size: 25rpx;
}

.field:last-child {
  border-bottom: 0;
}

.field text:last-child {
  max-width: 430rpx;
  color: #EDE8DF;
  text-align: right;
  word-break: break-all;
}

.description {
  color: #D8D0BE;
  font-size: 26rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-word;
}

.state-actions button::after {
  border: 0;
}

.ghost-btn,
.primary-btn.small {
  width: 100%;
  height: 88rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 44rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 88rpx;
}

.primary-btn.small {
  background: #C8A055;
  color: #18160F;
}

.ghost-btn {
  border: 1rpx solid rgba(200,160,85,0.32);
  background: #2A261D;
  color: #EDE8DF;
}

.state,
.skeleton {
  min-height: 720rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
}

.state {
  align-items: center;
  text-align: center;
}

.state-title {
  color: #EDE8DF;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.45;
}

.state-subtitle {
  max-width: 560rpx;
  margin-top: 14rpx;
  color: #8D836F;
  font-size: 24rpx;
  line-height: 1.6;
}

.state-actions {
  width: 100%;
  margin-top: 30rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.skeleton-media,
.skeleton-line,
.skeleton-card {
  border-radius: 18rpx;
  background: rgba(237,232,223,0.08);
}

.skeleton-media {
  height: 540rpx;
}

.skeleton-line {
  height: 28rpx;
  margin-top: 24rpx;
}

.skeleton-line.strong {
  width: 72%;
}

.skeleton-card {
  height: 180rpx;
  margin-top: 28rpx;
}

.card-press {
  opacity: 0.78;
}
