<view class="page">
  <custom-navigation title="品牌" />

  <view wx:if="{{status == 'loading'}}" class="skeleton-shell">
    <view class="skeleton-hero"></view>
    <view class="skeleton-list">
      <view class="skeleton-row" wx:for="{{skeletons}}" wx:key="*this">
        <view class="skeleton-logo"></view>
        <view class="skeleton-copy">
          <view class="skeleton-line strong"></view>
          <view class="skeleton-line"></view>
        </view>
        <view class="skeleton-tags">
          <view class="skeleton-pill"></view>
          <view class="skeleton-pill short"></view>
        </view>
      </view>
    </view>
  </view>

  <view wx:elif="{{status == 'error'}}" class="state">
    <view class="state-title">品牌列表加载失败</view>
    <view class="state-desc">请检查网络或稍后重试。</view>
    <button class="primary-btn" bindtap="retryLoad">重新加载</button>
  </view>

  <view wx:elif="{{status == 'empty'}}" class="state">
    <view class="state-title">暂无公开品牌</view>
    <view class="state-desc">可以先按分类浏览公开商品。</view>
    <button class="primary-btn" bindtap="openCategory">去看分类</button>
  </view>

  <view wx:else class="brand-content">
    <swiper
      wx:if="{{banners.length}}"
      class="brand-hero"
      autoplay
      circular
      interval="4500"
      duration="450"
      indicator-dots
      indicator-color="rgba(237,232,223,0.32)"
      indicator-active-color="#C8A055"
    >
      <swiper-item wx:for="{{banners}}" wx:key="id">
        <view class="brand-slide" bindtap="openBanner" data-banner="{{item}}" data-index="{{index}}">
          <image
            class="brand-hero-image"
            src="{{item.image_url}}"
            mode="aspectFill"
            binderror="onImageError"
            data-index="{{index}}"
          ></image>
          <view class="brand-hero-shade"></view>
          <view class="brand-hero-copy">
            <view class="brand-hero-title">{{item.title || '全球严选瓷砖品牌'}}</view>
            <view wx:if="{{item.subtitle}}" class="brand-hero-subtitle">{{item.subtitle}}</view>
          </view>
        </view>
      </swiper-item>
    </swiper>

    <view wx:else class="brand-hero fallback">
      <view class="brand-hero-copy">
        <view class="brand-hero-title">全球严选瓷砖品牌</view>
      </view>
    </view>

    <view class="section-head">
      <view class="section-title">品牌矩阵</view>
    </view>

    <view class="brand-list">
      <view
        class="brand-row"
        wx:for="{{items}}"
        wx:for-index="brandIndex"
        wx:key="brand_id"
        data-index="{{brandIndex}}"
      >
        <view class="brand-entry" data-index="{{brandIndex}}" catchtap="onBrandInfoTap" hover-class="brand-entry-press">
          <view class="brand-logo">
            <image
              wx:if="{{item.brand_logo_thumbnail_url || item.brand_logo_url}}"
              class="brand-logo-image"
              src="{{item.brand_logo_thumbnail_url || item.brand_logo_url}}"
              mode="aspectFit"
              binderror="onLogoError"
              data-index="{{brandIndex}}"
            ></image>
            <text wx:else class="brand-logo-fallback">{{item.fallback_text}}</text>
          </view>
          <view class="brand-copy">
            <view class="brand-name">{{item.brand_name}}</view>
            <view class="brand-count">{{item.product_count_text}}</view>
          </view>
          <view class="brand-arrow">›</view>
        </view>
        <view class="brand-categories">
          <block wx:if="{{item.category_items.length}}">
            <view
              class="category-pill"
              wx:for="{{item.category_items}}"
              wx:for-item="category"
              wx:for-index="categoryIndex"
              wx:key="category_id"
              data-brand-index="{{brandIndex}}"
              data-category-index="{{categoryIndex}}"
              catchtap="onCategoryTap"
            >{{category.category_name}}</view>
          </block>
          <view wx:else class="category-empty">暂无类目</view>
        </view>
      </view>
    </view>

    <view wx:if="{{loadingMore}}" class="load-more">加载更多...</view>
    <view wx:elif="{{loadMoreError}}" class="load-more retry" bindtap="retryLoadMore">{{loadMoreError}}</view>
    <view wx:elif="{{!hasMore}}" class="load-more">已经到底了</view>
  </view>
  <home-floating-button offset="tabbar" />
</view>
