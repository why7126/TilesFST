<view class="page">
  <custom-navigation title="{{title}}" />

  <view class="product-search-entry">
    <search-entry
      keyword="{{keyword}}"
      scope="{{categoryId ? 'category' : brandId ? 'brand' : section || 'product-list'}}"
      source-page="product-list"
      placeholder="{{categoryName ? '在' + categoryName + '中搜索商品' : brandId ? '在当前品牌中搜索商品' : section ? '在当前榜单中搜索商品' : '搜索当前商品列表'}}"
      disabled="{{loading}}"
      bind:input="onSearchInput"
      bind:submit="onSearchSubmit"
      bind:clear="clearSearchKeyword"
      bind:cancel="openGlobalSearch"
    />
  </view>

  <view wx:if="{{loading}}" class="skeleton-grid">
    <view class="skeleton-card" wx:for="{{skeletons}}" wx:key="*this">
      <view class="skeleton-image"></view>
      <view class="skeleton-copy">
        <view class="skeleton-line strong"></view>
        <view class="skeleton-line"></view>
        <view class="skeleton-line short"></view>
      </view>
    </view>
  </view>

  <view wx:elif="{{error}}" class="state">
    <view>{{error}}</view>
    <button class="retry-btn" bindtap="retryLoad">重新加载</button>
  </view>

  <view wx:elif="{{!items.length}}" class="state">
    <view>{{emptyText}}</view>
    <button wx:if="{{keyword}}" class="retry-btn secondary" bindtap="clearSearchKeyword">清空关键词</button>
    <button class="retry-btn" bindtap="openGlobalSearch">去全局搜索调整</button>
  </view>

  <view wx:else class="product-list">
    <view class="product-grid">
      <product-card
        wx:for="{{items}}"
        wx:key="product_id"
        product="{{item}}"
        density="grid"
        source-page="product-list"
        source-module="{{section || 'list'}}"
        category-id="{{categoryId}}"
        brand-id="{{brandId}}"
        keyword="{{keyword}}"
        list-context="{{title}}"
        index="{{index}}"
        request-id="{{requestId}}"
        image-fallback="{{imageFallback}}"
      />
    </view>

    <view wx:if="{{loadingMore}}" class="load-more">加载更多...</view>
    <view wx:elif="{{loadMoreError}}" class="load-more retry" bindtap="retryLoadMore">{{loadMoreError}}</view>
    <view wx:elif="{{!hasMore}}" class="load-more">已经到底了</view>
  </view>
  <home-floating-button offset="list" />
</view>
