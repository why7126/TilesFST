# 文档用途：Web容器Nginx运行时模板
# 文档内容：静态资源托管、SPA回退、API反向代理、上传路径专用超时
# 内容来源：OpenSpec Change fix-upload-proxy-timeout-config
# 更新方式：路由策略、上传限制或后端服务名变化时同步更新 nginx.conf 与测试
# 备注：由 Nginx 官方镜像 entrypoint 渲染到 /etc/nginx/conf.d/default.conf

server {
    listen 80;
    server_name _;

    # 须 >= max(MAX_IMAGE_SIZE_MB, MAX_VIDEO_SIZE_MB, MAX_FILE_SIZE_MB)；默认按 MAX_VIDEO_SIZE_MB=500 预留
    client_max_body_size ${UPLOAD_CLIENT_MAX_BODY_SIZE};
    client_body_timeout ${UPLOAD_CLIENT_BODY_TIMEOUT_SECONDS}s;
    send_timeout ${UPLOAD_SEND_TIMEOUT_SECONDS}s;

    root /usr/share/nginx/html;
    index index.html;

    location = /api/v1/admin/uploads {
        proxy_pass http://tilesfst-backend:8000/api/v1/admin/uploads;
        proxy_request_buffering ${UPLOAD_PROXY_REQUEST_BUFFERING};
        proxy_connect_timeout ${UPLOAD_PROXY_CONNECT_TIMEOUT_SECONDS}s;
        proxy_send_timeout ${UPLOAD_PROXY_SEND_TIMEOUT_SECONDS}s;
        proxy_read_timeout ${UPLOAD_PROXY_READ_TIMEOUT_SECONDS}s;
        client_max_body_size ${UPLOAD_CLIENT_MAX_BODY_SIZE};
        client_body_timeout ${UPLOAD_CLIENT_BODY_TIMEOUT_SECONDS}s;
        send_timeout ${UPLOAD_SEND_TIMEOUT_SECONDS}s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/v1/admin/uploads/ {
        proxy_pass http://tilesfst-backend:8000/api/v1/admin/uploads/;
        proxy_request_buffering ${UPLOAD_PROXY_REQUEST_BUFFERING};
        proxy_connect_timeout ${UPLOAD_PROXY_CONNECT_TIMEOUT_SECONDS}s;
        proxy_send_timeout ${UPLOAD_PROXY_SEND_TIMEOUT_SECONDS}s;
        proxy_read_timeout ${UPLOAD_PROXY_READ_TIMEOUT_SECONDS}s;
        client_max_body_size ${UPLOAD_CLIENT_MAX_BODY_SIZE};
        client_body_timeout ${UPLOAD_CLIENT_BODY_TIMEOUT_SECONDS}s;
        send_timeout ${UPLOAD_SEND_TIMEOUT_SECONDS}s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://tilesfst-backend:8000/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /openapi.json {
        proxy_pass http://tilesfst-backend:8000/openapi.json;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /docs {
        proxy_pass http://tilesfst-backend:8000/docs;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /docs/ {
        proxy_pass http://tilesfst-backend:8000/docs/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /redoc {
        proxy_pass http://tilesfst-backend:8000/redoc;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /redoc/ {
        proxy_pass http://tilesfst-backend:8000/redoc/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /media/ {
        proxy_pass http://tilesfst-backend:8000/media/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
