# ==============================================================================
# 环境标识
# ==============================================================================
# 环境 ID；候选值见 deploy/README.md，本文件固定为 prod-mysql-tencent-cos；复制为 deploy/prod/mysql-tencent-cos.env 后替换所有生产占位值，真实 env 禁止提交。
TILESFST_DEPLOY_ENV_ID=prod-mysql-tencent-cos
# 运行环境；候选值：development / staging / production；生产必须为 production。
APP_ENV=production

# ==============================================================================
# 应用安全
# ==============================================================================
# 调试开关；候选值：true / false；生产必须为 false。
APP_DEBUG=false
# 生产签名密钥；候选值：密钥系统生成的高强度随机值；禁止使用示例值。
APP_SECRET_KEY=replace-with-production-secret-key
# 生产管理员用户名；候选值：admin 或项目约定管理员用户名；仅首次建库或受控重置时使用。
ADMIN_USERNAME=admin
# 生产管理员初始密码；候选值：密码管理器生成的强密码；必须替换为安全值。
ADMIN_INITIAL_PASSWORD=replace-with-production-admin-password

# ==============================================================================
# 数据库
# ==============================================================================
# 生产 MySQL 8.0+ 连接串；候选格式：mysql+pymysql://user:password@host:3306/db?charset=utf8mb4；禁止 SQLite。
DATABASE_URL=mysql+pymysql://tiles_user:replace-with-secret@mysql.example.com:3306/tilesfst?charset=utf8mb4

# ==============================================================================
# 镜像
# ==============================================================================
# 后端生产镜像仓库；候选值：tilesfst-backend 或私有仓库地址。
TILESFST_BACKEND_IMAGE_REPOSITORY=tilesfst-backend
# Web 生产镜像仓库；候选值：tilesfst-web 或私有仓库地址。
TILESFST_WEB_IMAGE_REPOSITORY=tilesfst-web
# backend/web 统一镜像 tag；候选值：vX.Y.Z；发布时必须设置为目标版本。
TILESFST_IMAGE_TAG=v0.0.1
# 生产媒体维护任务复用后端镜像 tag；启用 maintenance profile 时仅运行一次性 CLI，不随业务服务默认启动。
# 写操作仍必须在命令行显式传入 --apply --confirm-backup，并先完成 MySQL 与对象存储快照。

# ==============================================================================
# 对象存储
# ==============================================================================
# 对象存储 provider；候选值：tencent-cos；本生产环境固定腾讯云 COS。
OBJECT_STORAGE_PROVIDER=tencent-cos
# 腾讯云 COS S3 兼容 endpoint；候选格式：cos.<region>.myqcloud.com，按 bucket region 配置。
OBJECT_STORAGE_ENDPOINT=cos.ap-guangzhou.myqcloud.com
# 腾讯云 SecretId；候选值：密钥系统注入的真实 SecretId；真实值禁止提交。
OBJECT_STORAGE_ACCESS_KEY=replace-with-tencent-cos-secret-id
# 腾讯云 SecretKey；候选值：密钥系统注入的真实 SecretKey；真实值禁止提交。
OBJECT_STORAGE_SECRET_KEY=replace-with-tencent-cos-secret-key
# 是否使用 HTTPS；候选值：true / false；生产 COS 必须为 true。
OBJECT_STORAGE_SECURE=true
# 生产 COS bucket；候选值：运维提前创建的 bucket 名；禁止示例值。
OBJECT_STORAGE_BUCKET=replace-with-cos-bucket
# 生产 COS region；候选值：ap-guangzhou / ap-shanghai / ap-beijing / ap-chengdu 等。
OBJECT_STORAGE_REGION=ap-guangzhou
# 访问风格；候选值：true / false；COS 通常使用 false。
OBJECT_STORAGE_PATH_STYLE=false
# 是否允许自动建桶；候选值：true / false；生产云上对象存储必须为 false。
OBJECT_STORAGE_AUTO_CREATE_BUCKET=false

# ==============================================================================
# 端口
# ==============================================================================
# 生产后端宿主机端口；候选值：8000 或由反代/防火墙规划的未占用端口。
HOST_PORT_BACKEND=8000
# 生产 Web 宿主机端口；候选值：3000、80 或由反代/防火墙规划的未占用端口。
HOST_PORT_WEB=3000
# 生产 Mintlify 文档站宿主机端口；候选值：3001 或由反代/防火墙规划的未占用端口；prod 默认启动 tilesfst-docs-site。
HOST_PORT_MINTLIFY_DOCS=3001
# Docs-site Docker 构建 Node 基础镜像；网络受限时可改为 m.daocloud.io/docker.io/node:22-alpine。
DOCS_SITE_NODE_BASE_IMAGE=node:22-alpine
# Docs-site 预览镜像仓库名；Compose 会拼接为 ${TILESFST_DOCS_SITE_IMAGE_REPOSITORY}:${TILESFST_IMAGE_TAG}。
TILESFST_DOCS_SITE_IMAGE_REPOSITORY=tilesfst-docs-site
# Docs-site 镜像内预装的 Mintlify CLI 版本；升级前需通过文档站校验与 preview 验收。
MINTLIFY_CLI_VERSION=4.2.45

# ==============================================================================
# Docker 构建基础镜像
# ==============================================================================
# 后端 Docker 构建 Python 基础镜像；网络受限时可改为 m.daocloud.io/docker.io/python:3.12-slim。
BACKEND_PYTHON_BASE_IMAGE=python:3.12-slim
# Web Docker 构建 Node 基础镜像；网络受限时可改为 m.daocloud.io/docker.io/node:22-alpine。
WEB_NODE_BASE_IMAGE=node:22-alpine
# Web Docker 运行 Nginx 基础镜像；网络受限时可改为 m.daocloud.io/docker.io/nginx:1.27-alpine。
WEB_NGINX_BASE_IMAGE=nginx:1.27-alpine

# ==============================================================================
# Web 上传反代
# ==============================================================================
# Web Nginx 上传请求体大小上限；候选值：512m 或不小于 MAX_VIDEO_SIZE_MB 的值。
UPLOAD_CLIENT_MAX_BODY_SIZE=512m
# Web Nginx 读取浏览器上传请求体超时秒数；候选值：600 或按大文件上传耗时规划。
UPLOAD_CLIENT_BODY_TIMEOUT_SECONDS=600
# Web Nginx 连接 tilesfst-backend 超时秒数；候选值：60 或按容器网络规划。
UPLOAD_PROXY_CONNECT_TIMEOUT_SECONDS=60
# Web Nginx 向 tilesfst-backend 发送上传请求超时秒数；候选值：600 或按大文件上传耗时规划。
UPLOAD_PROXY_SEND_TIMEOUT_SECONDS=600
# Web Nginx 等待 tilesfst-backend 上传响应超时秒数；候选值：600 或按对象存储写入耗时规划。
UPLOAD_PROXY_READ_TIMEOUT_SECONDS=600
# Web Nginx 向浏览器发送响应超时秒数；候选值：600 或按大文件上传耗时规划。
UPLOAD_SEND_TIMEOUT_SECONDS=600
# Web Nginx 是否缓冲上传请求体；候选值：off / on；大文件上传默认 off。
UPLOAD_PROXY_REQUEST_BUFFERING=off
