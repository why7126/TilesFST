# ==============================================================================
# 环境标识
# ==============================================================================
# 环境 ID；候选值见 deploy/README.md，本文件固定为 local-sqlite-minio-external；可复制为 deploy/local/sqlite-minio-external.env，本地真实 env 禁止提交。
TILESFST_DEPLOY_ENV_ID=local-sqlite-minio-external
# 运行环境；候选值：development / staging / production；本文件仅用于本地开发。
APP_ENV=development

# ==============================================================================
# 应用安全
# ==============================================================================
# 调试开关；候选值：true / false；本地可为 true，生产必须为 false。
APP_DEBUG=true
# 应用签名密钥；候选值：本地示例值或本地随机密钥；生产不得使用示例值。
APP_SECRET_KEY=change-me-in-local-env
# 默认管理员用户名；候选值：admin 或本地约定用户名。
ADMIN_USERNAME=admin
# 默认管理员初始密码；候选值：本地示例密码或本地临时密码；生产不得使用。
ADMIN_INITIAL_PASSWORD=change-me-on-first-run

# ==============================================================================
# 数据库
# ==============================================================================
# 数据库连接串；候选值：sqlite:////app/data/sqlite/tilesfst.db 或 mysql+pymysql://...；本环境固定 SQLite。
DATABASE_URL=sqlite:////app/data/sqlite/tilesfst.db

# ==============================================================================
# 对象存储
# ==============================================================================
# 对象存储 provider；候选值：minio / self-hosted-minio / s3-compatible / tencent-cos / volcengine-tos；本环境固定 self-hosted-minio。
OBJECT_STORAGE_PROVIDER=self-hosted-minio
# 对象存储 endpoint；候选值：host.docker.internal:9000、127.0.0.1:9000 或实际外部 MinIO endpoint。
OBJECT_STORAGE_ENDPOINT=host.docker.internal:9000
# 对象存储 access key；候选值：本机 MinIO access key 占位值；真实值禁止提交。
OBJECT_STORAGE_ACCESS_KEY=replace-with-local-minio-access-key
# 对象存储 secret key；候选值：本机 MinIO secret key 占位值；真实值禁止提交。
OBJECT_STORAGE_SECRET_KEY=replace-with-local-minio-secret-key
# 是否使用 HTTPS；候选值：true / false；本机 MinIO 通常为 false。
OBJECT_STORAGE_SECURE=false
# 单桶策略 bucket 名；候选值：tilesfst 或本地自定义 bucket。
OBJECT_STORAGE_BUCKET=tilesfst
# 对象存储 region；候选值：空、local、ap-guangzhou 等；本机 MinIO 可留空。
OBJECT_STORAGE_REGION=
# 访问风格；候选值：true / false；MinIO 通常为 true。
OBJECT_STORAGE_PATH_STYLE=true
# 是否允许自动建桶；候选值：true / false；本地外部 MinIO 可按需为 true。
OBJECT_STORAGE_AUTO_CREATE_BUCKET=true

# ==============================================================================
# 端口
# ==============================================================================
# 宿主机 Web 端口；候选值：3000 或未占用端口。
HOST_PORT_WEB=3000
# 宿主机后端端口；候选值：8000 或未占用端口。
HOST_PORT_BACKEND=8000
# 宿主机 MinIO API 端口；仅启用 self-hosted-storage profile 时使用；候选值：9000 或未占用端口。
HOST_PORT_MINIO_API=9000
# 宿主机 MinIO Console 端口；仅启用 self-hosted-storage profile 时使用；候选值：9001 或未占用端口。
HOST_PORT_MINIO_CONSOLE=9001
# 宿主机 Mintlify 文档站预览端口；候选值：3001 或未占用端口；local 默认启动 tilesfst-docs-site。
HOST_PORT_MINTLIFY_DOCS=3001
# Mintlify 文档站预览使用的 Node 镜像；网络受限时可改为 m.daocloud.io/docker.io/node:22-alpine。
MINTLIFY_NODE_IMAGE=node:22-alpine

# ==============================================================================
# Docker 构建基础镜像
# ==============================================================================
# 后端 Docker 构建 Python 基础镜像；网络受限时可改为 m.daocloud.io/docker.io/python:3.12-slim。
BACKEND_PYTHON_BASE_IMAGE=python:3.12-slim
# Web Docker 构建 Node 基础镜像；网络受限时可改为 m.daocloud.io/docker.io/node:22-alpine。
WEB_NODE_BASE_IMAGE=node:22-alpine
# Web Docker 运行 Nginx 基础镜像；网络受限时可改为 m.daocloud.io/docker.io/nginx:1.27-alpine。
WEB_NGINX_BASE_IMAGE=nginx:1.27-alpine

# ==============================================================================
# Web 上传反代
# ==============================================================================
# Web Nginx 上传请求体大小上限；候选值：512m 或不小于 MAX_VIDEO_SIZE_MB 的值。
UPLOAD_CLIENT_MAX_BODY_SIZE=512m
# Web Nginx 读取浏览器上传请求体超时秒数；候选值：600 或按大文件上传耗时规划。
UPLOAD_CLIENT_BODY_TIMEOUT_SECONDS=600
# Web Nginx 连接 tilesfst-backend 超时秒数；候选值：60 或按容器网络规划。
UPLOAD_PROXY_CONNECT_TIMEOUT_SECONDS=60
# Web Nginx 向 tilesfst-backend 发送上传请求超时秒数；候选值：600 或按大文件上传耗时规划。
UPLOAD_PROXY_SEND_TIMEOUT_SECONDS=600
# Web Nginx 等待 tilesfst-backend 上传响应超时秒数；候选值：600 或按对象存储写入耗时规划。
UPLOAD_PROXY_READ_TIMEOUT_SECONDS=600
# Web Nginx 向浏览器发送响应超时秒数；候选值：600 或按大文件上传耗时规划。
UPLOAD_SEND_TIMEOUT_SECONDS=600
# Web Nginx 是否缓冲上传请求体；候选值：off / on；大文件上传默认 off。
UPLOAD_PROXY_REQUEST_BUFFERING=off
